{
  "extends": [
    "universe",
    "universe/native",
    "universe/web",
    "universe/shared/typescript-analysis",
    "prettier"
  ],
  "plugins": [
    "prettier",
    "react-hooks"
  ],
  "rules": {
    "prettier/prettier": "error",
    "react-native/no-inline-styles": "off",
    "import/order": "off"
  },
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.d.ts"
      ],
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    }
  ]
}
